# Copy to .env and fill in. Compose reads .env automatically; .env is
# gitignored. Values marked :? must be set or `docker compose up` refuses.

# PocketBase superuser: auto-created on first start, used by Brillante's
# admin bootstrap and tutor api_key storage. Pick a strong password.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-long-and-random

# Optional Auth0-backed SSO (Google + GitHub). Leave blank to disable.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
