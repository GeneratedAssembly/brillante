FROM docker.io/library/alpine:3.20

RUN apk add --no-cache ca-certificates

# The binary lives in the mounted /pb dir (pocketbase/pocketbase on the host);
# PocketBase resolves pb_hooks/ and pb_migrations/ next to the executable, so
# the binary must sit inside the mounted directory, not in /usr/local/bin.
WORKDIR /pb
EXPOSE 8090

ENTRYPOINT ["/pb/pocketbase"]
CMD ["serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data"]
